  <!-- EN: EGO Seed studied: {RESEARCH} unlocked -->
  <OE_EGOSeed.comps.CompAnalyzableUnlockResearch.completedLetterLabel>EGO种子已研究：{RESEARCH}已解锁</OE_EGOSeed.comps.CompAnalyzableUnlockResearch.completedLetterLabel>
