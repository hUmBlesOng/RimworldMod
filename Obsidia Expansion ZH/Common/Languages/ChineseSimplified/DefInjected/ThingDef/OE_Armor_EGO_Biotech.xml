<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: EGO Shell(Automancer) -->
  <EGO_Armor_Shell_Mechanitor.label>EGO外壳（机械师）</EGO_Armor_Shell_Mechanitor.label>
  <!-- EN: Specially gestated amalgam Shell, excellent protects the owner. Designed for use by Undyings. Amalgams are hybrids of EGO seed and Obsidia technology.\n\nThis modification improve mechanitor stats and modified with the pack that allows the user to deploy a battery-powered turret.\n\nThe item's quality levels can be reset using an EGO Seed. -->
  <EGO_Armor_Shell_Mechanitor.description>特殊培育的融合体外壳，出色地保护穿戴者。专为不死者设计。融合体是EGO种子与黑曜石科技的混合体。\n\n此改装提高了机械师属性并增加了可部署电池供电炮塔的背包。\n\n该物品的品质等级可以使用EGO种子重置。</EGO_Armor_Shell_Mechanitor.description>
  <!-- EN: incendiary -->
  <EGO_Armor_Shell_Mechanitor.comps.CompApparelReloadable.chargeNoun>燃烧弹</EGO_Armor_Shell_Mechanitor.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <EGO_Armor_Shell_Mechanitor.comps.CompApparelReloadable.cooldownGerund>冷却中</EGO_Armor_Shell_Mechanitor.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: deploy turret -->
  <EGO_Armor_Shell_Mechanitor.verbs.deploy_turret.label>部署炮塔</EGO_Armor_Shell_Mechanitor.verbs.deploy_turret.label>
  
  <!-- EN: EGO Automancer Turret -->
  <EGO_Gun_TacticalTurret.label>EGO机械师炮塔</EGO_Gun_TacticalTurret.label>
  <!-- EN: Reconstructed EGO Amalgam Pistol for turrets. -->
  <EGO_Gun_TacticalTurret.description>为炮塔重构的EGO融合体手枪。</EGO_Gun_TacticalTurret.description>
  <!-- EN: EGO Automancer Turret -->
  <EGO_Gun_TacticalTurret.verbs.Verb_Shoot.label>EGO机械师炮塔</EGO_Gun_TacticalTurret.verbs.Verb_Shoot.label>
  
  <!-- EN: EGO Automancer turret -->
  <EGO_Turret_TacticalTurret.label>EGO机械师炮塔</EGO_Turret_TacticalTurret.label>
  <!-- EN: An automatic EGO Amalgam Pistol-equipped turret. It will stop functioning once its battery runs out. -->
  <EGO_Turret_TacticalTurret.description>一种自动EGO融合体手枪炮塔。电池耗尽后将停止运作。</EGO_Turret_TacticalTurret.description>
  <!-- EN: Battery power -->
  <EGO_Turret_TacticalTurret.comps.CompMechPowerCell.labelOverride>电池供电</EGO_Turret_TacticalTurret.comps.CompMechPowerCell.labelOverride>
  <!-- EN: This turret has a limited battery life. Once it runs out, it will stop working entirely. -->
  <EGO_Turret_TacticalTurret.comps.CompMechPowerCell.tooltipOverride>该炮塔电池寿命有限。一旦耗尽，将完全停止工作。</EGO_Turret_TacticalTurret.comps.CompMechPowerCell.tooltipOverride>
  
  <!-- EN: EGO turret pack capsule -->
  <Grenade_Armor_EGO_TurretPack.label>EGO炮塔背包胶囊</Grenade_Armor_EGO_TurretPack.label>
  
</LanguageData>