<LanguageData>
  
  <!-- EN: CAC Blackout Turret -->
  <CAC_Turret_Big.label>CAC黑障炮塔</CAC_Turret_Big.label>
  <!-- EN: An automatic CAC Minigun-equipped turret. Requires obsidia ammo kit as fuel. Its dumb AI brain can't be directly controlled, so beware of friendly fire. -->
  <CAC_Turret_Big.description>一种自动CAC迷你枪炮塔。需要黑曜石弹药包作为燃料。其简单的AI大脑无法直接控制，因此需要注意友军火力。</CAC_Turret_Big.description>
  <!-- EN: Fuel capacity -->
  <CAC_Turret_Big.comps.CompRefuelable.fuelGizmoLabel>燃料容量</CAC_Turret_Big.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: Shoots until run out of charges -->
  <CAC_Turret_Big.comps.CompRefuelable.fuelLabel>射击直至耗尽充能</CAC_Turret_Big.comps.CompRefuelable.fuelLabel>
  <!-- EN: Cannot shoot: Needs obsidia ammo kit -->
  <CAC_Turret_Big.comps.CompRefuelable.outOfFuelMessage>无法射击：需要黑曜石弹药包</CAC_Turret_Big.comps.CompRefuelable.outOfFuelMessage>
  
