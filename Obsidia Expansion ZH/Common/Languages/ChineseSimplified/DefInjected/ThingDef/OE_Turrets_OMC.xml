<LanguageData>
  
  <!-- EN: OMC Striker Turret -->
  <OMC_Turret_Big.label>OMC striker炮塔</OMC_Turret_Big.label>
  <!-- EN: An automatic OMC Assault Rifle-equipped turret. Requires obsidia ammo kit as fuel. Its dumb AI brain can't be directly controlled, so beware of friendly fire. -->
  <OMC_Turret_Big.description>一种自动OMC突击步枪炮塔。需要黑曜石弹药包作为燃料。其简单的AI大脑无法直接控制，因此需要注意友军火力。</OMC_Turret_Big.description>
  <!-- EN: Fuel capacity -->
  <OMC_Turret_Big.comps.CompRefuelable.fuelGizmoLabel>燃料容量</OMC_Turret_Big.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: Shoots until run out of charges -->
  <OMC_Turret_Big.comps.CompRefuelable.fuelLabel>射击直至耗尽充能</OMC_Turret_Big.comps.CompRefuelable.fuelLabel>
  <!-- EN: Cannot shoot: Needs obsidia ammo kit -->
  <OMC_Turret_Big.comps.CompRefuelable.outOfFuelMessage>无法射击：需要黑曜石弹药包</OMC_Turret_Big.comps.CompRefuelable.outOfFuelMessage>
  
