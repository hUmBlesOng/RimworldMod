  <!-- EN: compressed syntherius -->
  <OE_SyntheriusPack.label>压缩合成素</OE_SyntheriusPack.label>
  <!-- EN: A batch of syntherius hermetically compressed into a special container for safe transportation and storage.\n\nFor further use, be sure to decompresse it. -->
  <OE_SyntheriusPack.description>一批合成素被密封压缩到特殊容器中以便安全运输和储存。\n\n如需进一步使用，请务必进行解压。</OE_SyntheriusPack.description>
  <!-- EN: Decompresse syntherius -->
  <OE_SyntheriusPack.comps.CompUsable.useLabel>解压合成素</OE_SyntheriusPack.comps.CompUsable.useLabel>
  
