  <!-- EN: Grieving Turret -->
  <CAC_Gun_TacticalTurret.label>悲伤炮塔</CAC_Gun_TacticalTurret.label>
  <!-- EN: Reconstructed CAC Shotgun for turrets. -->
  <CAC_Gun_TacticalTurret.description>为炮塔重构的CAC霰弹枪。</CAC_Gun_TacticalTurret.description>
  <!-- EN: Grieving Turret -->
  <CAC_Gun_TacticalTurret.verbs.Verb_Shoot.label>悲伤炮塔</CAC_Gun_TacticalTurret.verbs.Verb_Shoot.label>
  
  <!-- EN: CAC Cultist Heavy Armor(Goblin) -->
  <CAC_HeavyArmor_Turret.label>CAC教派重型护甲（哥布林）</CAC_HeavyArmor_Turret.label>
  <!-- EN: Heavy power armor, excellent protects the owner. Designed and modified for use by CAC Cultists.\n\nModified with the pack that allows the user to deploy a battery-powered turret. -->
  <CAC_HeavyArmor_Turret.description>重型动力护甲，出色地保护穿戴者。由CAC教派设计和改良。\n\n加装了可部署电池供电炮塔的背包的改良版本。</CAC_HeavyArmor_Turret.description>
  <!-- EN: incendiary -->
  <CAC_HeavyArmor_Turret.comps.CompApparelReloadable.chargeNoun>燃烧弹</CAC_HeavyArmor_Turret.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <CAC_HeavyArmor_Turret.comps.CompApparelReloadable.cooldownGerund>冷却中</CAC_HeavyArmor_Turret.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: deploy turret -->
  <CAC_HeavyArmor_Turret.verbs.deploy_turret.label>部署炮塔</CAC_HeavyArmor_Turret.verbs.deploy_turret.label>
  
  <!-- EN: CAC Cultist Light Armor(Goblin) -->
  <CAC_LightArmor_Turret.label>CAC教派轻型护甲（哥布林）</CAC_LightArmor_Turret.label>
  <!-- EN: Light power armor, well protects the owner. Designed and modified for use by CAC Cultists.\n\nModified with the pack that allows the user to deploy a battery-powered turret. -->
  <CAC_LightArmor_Turret.description>轻型动力护甲，良好地保护穿戴者。由CAC教派设计和改良。\n\n加装了可部署电池供电炮塔的背包的改良版本。</CAC_LightArmor_Turret.description>
  <!-- EN: incendiary -->
  <CAC_LightArmor_Turret.comps.CompApparelReloadable.chargeNoun>燃烧弹</CAC_LightArmor_Turret.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <CAC_LightArmor_Turret.comps.CompApparelReloadable.cooldownGerund>冷却中</CAC_LightArmor_Turret.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: deploy turret -->
  <CAC_LightArmor_Turret.verbs.deploy_turret.label>部署炮塔</CAC_LightArmor_Turret.verbs.deploy_turret.label>
  
  <!-- EN: CAC Priest Armor -->
  <CAC_PriestArmor.label>CAC祭司护甲</CAC_PriestArmor.label>
  <!-- EN: Heavy power armor, excellent protects the owner. Designed and modified for use by CAC Priests.\n\nIt has a built-in module with a flare dispenser. -->
  <CAC_PriestArmor.description>重型动力护甲，出色地保护穿戴者。由CAC祭司设计和改良。\n\n内置了照明弹发射器模块。</CAC_PriestArmor.description>
  <!-- EN: flare -->
  <CAC_PriestArmor.comps.CompApparelReloadable.chargeNoun>照明弹</CAC_PriestArmor.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <CAC_PriestArmor.comps.CompApparelReloadable.cooldownGerund>冷却中</CAC_PriestArmor.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: deploy flare -->
  <CAC_PriestArmor.verbs.deploy_flare.label>部署照明弹</CAC_PriestArmor.verbs.deploy_flare.label>
  
  <!-- EN: CAC tactical turret -->
  <CAC_Turret_TacticalTurret.label>CAC战术炮塔</CAC_Turret_TacticalTurret.label>
  <!-- EN: An automatic CAC Shotgun-equipped turret. It will stop functioning once its battery runs out. -->
  <CAC_Turret_TacticalTurret.description>一种自动CAC霰弹枪炮塔。电池耗尽后将停止运作。</CAC_Turret_TacticalTurret.description>
  <!-- EN: Battery power -->
  <CAC_Turret_TacticalTurret.comps.CompMechPowerCell.labelOverride>电池供电</CAC_Turret_TacticalTurret.comps.CompMechPowerCell.labelOverride>
  <!-- EN: This turret has a limited battery life. Once it runs out, it will stop working entirely. -->
  <CAC_Turret_TacticalTurret.comps.CompMechPowerCell.tooltipOverride>该炮塔电池寿命有限。一旦耗尽，将完全停止工作。</CAC_Turret_TacticalTurret.comps.CompMechPowerCell.tooltipOverride>
  
  <!-- EN: CAC turret pack capsule -->
  <Grenade_Armor_CAC_TurretPack.label>CAC炮塔背包胶囊</Grenade_Armor_CAC_TurretPack.label>
  
