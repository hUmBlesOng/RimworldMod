  <!-- EN: Cyber Arachna -->
  <OE_CyberArachna.label>赛博蜘蛛</OE_CyberArachna.label>
  <!-- EN: Cyber Arachna is a hybrid of Crimson Arachna Cultist with a mechanoid body. This creature is extremely durable and armored, but has a low movement speed. It's the result of one of the first unsuccessful experiments of Crimson Arachna Cult in the artificial hybridization of the powers of Crimson Arachna. -->
  <OE_CyberArachna.description>赛博蜘蛛是深红蜘蛛教徒与机械体的混合体。这种生物极其耐用且有装甲，但移动速度较慢。这是深红蜘蛛教派在人工杂交深红蜘蛛力量的早期不成功实验之一的结果。</OE_CyberArachna.description>
  <!-- EN: chimera -->
  <OE_CyberArachna.comps.CompChimera.simpleAnimalLabel>奇美拉</OE_CyberArachna.comps.CompChimera.simpleAnimalLabel>
  <!-- EN: front left leg -->
  <OE_CyberArachna.tools.front_left_leg.label>左前腿</OE_CyberArachna.tools.front_left_leg.label>
  <!-- EN: front right leg -->
  <OE_CyberArachna.tools.front_right_leg.label>右前腿</OE_CyberArachna.tools.front_right_leg.label>
