<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: ODC turret pack capsule -->
  <Grenade_Armor_ODC_TurretPack.label>ODC炮塔背包胶囊</Grenade_Armor_ODC_TurretPack.label>
  
  <!-- EN: ODC Duelist Armor(Goblin) -->
  <ODC_Armor_Duelist_Turret.label>ODC决斗者护甲（哥布林）</ODC_Armor_Duelist_Turret.label>
  <!-- EN: Moded power armor, good protects the owner. Designed for use by Obsidia Drifters.\n\nDuelist version improves melee skills to the owner.\n\nModified with the pack that allows the user to deploy a battery-powered turret. -->
  <ODC_Armor_Duelist_Turret.description>改装动力护甲，良好地保护穿戴者。专为黑曜石漂泊者设计。\n\n决斗者版本提高穿戴者的近战技能。\n\n增加了可部署电池供电炮塔的背包的改良版本。</ODC_Armor_Duelist_Turret.description>
  <!-- EN: incendiary -->
  <ODC_Armor_Duelist_Turret.comps.CompApparelReloadable.chargeNoun>燃烧弹</ODC_Armor_Duelist_Turret.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <ODC_Armor_Duelist_Turret.comps.CompApparelReloadable.cooldownGerund>冷却中</ODC_Armor_Duelist_Turret.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: deploy turret -->
  <ODC_Armor_Duelist_Turret.verbs.deploy_turret.label>部署炮塔</ODC_Armor_Duelist_Turret.verbs.deploy_turret.label>
  
  <!-- EN: ODC Recon Armor(Goblin) -->
  <ODC_Armor_Recon_Turret.label>ODC侦察者护甲（哥布林）</ODC_Armor_Recon_Turret.label>
  <!-- EN: Moded power armor, good protects the owner. Designed for use by Obsidia Drifters.\n\nRecon version improves shooting skills to the owner.\n\nModified with the pack that allows the user to deploy a battery-powered turret. -->
  <ODC_Armor_Recon_Turret.description>改装动力护甲，良好地保护穿戴者。专为黑曜石漂泊者设计。\n\n侦察者版本提高穿戴者的射击技能。\n\n增加了可部署电池供电炮塔的背包的改良版本。</ODC_Armor_Recon_Turret.description>
  <!-- EN: incendiary -->
  <ODC_Armor_Recon_Turret.comps.CompApparelReloadable.chargeNoun>燃烧弹</ODC_Armor_Recon_Turret.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <ODC_Armor_Recon_Turret.comps.CompApparelReloadable.cooldownGerund>冷却中</ODC_Armor_Recon_Turret.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: deploy turret -->
  <ODC_Armor_Recon_Turret.verbs.deploy_turret.label>部署炮塔</ODC_Armor_Recon_Turret.verbs.deploy_turret.label>
  
  <!-- EN: Misfit Turret -->
  <ODC_Gun_TacticalTurret.label>不适配炮塔</ODC_Gun_TacticalTurret.label>
  <!-- EN: Reconstructed ODC SMG for turrets. -->
  <ODC_Gun_TacticalTurret.description>为炮塔重构的ODC冲锋枪。</ODC_Gun_TacticalTurret.description>
  <!-- EN: Misfit Turret -->
  <ODC_Gun_TacticalTurret.verbs.Verb_Shoot.label>不适配炮塔</ODC_Gun_TacticalTurret.verbs.Verb_Shoot.label>
  
  <!-- EN: ODC tactical turret -->
  <ODC_Turret_TacticalTurret.label>ODC战术炮塔</ODC_Turret_TacticalTurret.label>
  <!-- EN: An automatic ODC SMG-equipped turret. It will stop functioning once its battery runs out. -->
  <ODC_Turret_TacticalTurret.description>一种自动ODC冲锋枪炮塔。电池耗尽后将停止运作。</ODC_Turret_TacticalTurret.description>
  <!-- EN: Battery power -->
  <ODC_Turret_TacticalTurret.comps.CompMechPowerCell.labelOverride>电池供电</ODC_Turret_TacticalTurret.comps.CompMechPowerCell.labelOverride>
  <!-- EN: This turret has a limited battery life. Once it runs out, it will stop working entirely. -->
  <ODC_Turret_TacticalTurret.comps.CompMechPowerCell.tooltipOverride>该炮塔电池寿命有限。一旦耗尽，将完全停止工作。</ODC_Turret_TacticalTurret.comps.CompMechPowerCell.tooltipOverride>
  
</LanguageData>