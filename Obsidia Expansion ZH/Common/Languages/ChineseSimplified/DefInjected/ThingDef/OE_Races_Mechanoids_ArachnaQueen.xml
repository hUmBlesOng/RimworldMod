  <OE_Mech_CrimsonArachna.tools.front_left_leg.label>左前腿</OE_Mech_CrimsonArachna.tools.front_left_leg.label>
  <!-- EN: front right leg -->
  <OE_Mech_CrimsonArachna.tools.front_right_leg.label>右前腿</OE_Mech_CrimsonArachna.tools.front_right_leg.label>
  <!-- EN: head -->
  <OE_Mech_CrimsonArachna.tools.head.label>头部</OE_Mech_CrimsonArachna.tools.head.label>
  
