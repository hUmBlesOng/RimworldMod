  <!-- EN: OMC Soldier Armor -->
  <OMC_Armor.label>OMC士兵护甲</OMC_Armor.label>
  <!-- EN: Medium power armor, perfectly protects the owner with little mobility restriction. Designed for use by regular OMC soldiers. -->
